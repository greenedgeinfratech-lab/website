<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Our Services - GreenEdge Infratech</title>
  <meta name="description" content="Discover professional solar services by GreenEdge Infratech: solar installation, energy storage solutions, maintenance, and consulting.">
  <link rel="canonical" href="https://greenedgeinfratech.com/services" />
  <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">
  <%- include('partials/header') %>

  <!-- Services Hero -->
  <section class="py-20 bg-green-900 text-white relative">
    <div class="container mx-auto px-4 text-center">
      <div class="inline-flex items-center space-x-2 bg-white/20 backdrop-blur rounded-full px-4 py-1.5 mb-4 text-sm font-medium">
        <i class="fas fa-tools text-green-300"></i>
        <span>Engineering Excellence</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Comprehensive Solar Services</h1>
      <p class="text-lg md:text-xl text-green-100 max-w-2xl mx-auto">
        End-to-end clean energy execution from feasibility surveys to grid commissioning and 25-year operations.
      </p>
    </div>
  </section>

  <!-- Services List -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (services && services.length > 0) { %>
          <% services.forEach(service => { %>
            <div class="bg-gray-50 rounded-2xl shadow-md p-6 hover:shadow-xl transition duration-300 border border-gray-100 flex flex-col justify-between">
              <div>
                <% if (service.image_path) { %>
                  <img src="/<%= service.image_path %>" alt="<%= service.title %>" class="w-full h-52 object-cover rounded-xl mb-4">
                <% } %>
                <h3 class="text-xl font-bold mb-3 text-green-700">
                  <%= service.title %>
                </h3>
                <p class="text-gray-600 mb-4 text-sm leading-relaxed">
                  <%= service.description.replace(/<[^>]*>?/gm, '').substring(0, 160) %>...
                </p>
              </div>
              <div class="pt-4 border-t border-gray-200">
                <a href="/service-details?id=<%= service.id %>" class="inline-flex items-center text-green-600 font-semibold hover:text-green-800 text-sm">
                  View Full Details <i class="fas fa-arrow-right ml-1.5 text-xs"></i>
                </a>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
