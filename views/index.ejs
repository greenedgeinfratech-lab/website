<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Edge Infratech - Solar Energy Solutions</title>
    <meta name="description" content="GreenEdge Infratech provides rooftop solar energy solutions, professional solar panel installation, and customized clean power systems for homes and businesses.">
    <link rel="canonical" href="https://greenedgeinfratech.com/" />
    <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://greenedgeinfratech.com/" />
    <meta property="og:title" content="Green Edge Infratech - Solar Energy Solutions" />
    <meta property="og:description" content="GreenEdge Infratech provides rooftop solar energy solutions, professional solar panel installation, and customized clean power systems for homes and businesses." />
    <meta property="og:image" content="/assets/logo.png" />
    <meta property="og:site_name" content="GreenEdge Infratech" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://greenedgeinfratech.com/" />
    <meta name="twitter:title" content="Green Edge Infratech - Solar Energy Solutions" />
    <meta name="twitter:description" content="GreenEdge Infratech provides rooftop solar energy solutions, professional solar panel installation, and customized clean power systems for homes and businesses." />
    <meta name="twitter:image" content="/assets/logo.png" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
    .active-option {
        background-color: #16a34a !important;
        color: white !important;
    }
    .pdf-mode {
        background: #fff !important;
    }
    </style>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">

    <%- include('partials/header') %>

    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex items-center pt-16 overflow-hidden bg-slate-900">
        <div class="absolute inset-0">
            <img src="/assets/hero-solar.jpg" alt="Solar Farm Background" class="w-full h-full object-cover opacity-30" />
            <div class="absolute inset-0 bg-gradient-to-r from-green-950/95 via-green-900/80 to-slate-900/75"></div>
        </div>
        <div class="relative container mx-auto px-4 z-10 py-16">
            <div class="max-w-4xl">
                <div class="inline-flex items-center space-x-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
                    <i class="fas fa-sun text-yellow-400 w-4 h-4"></i>
                    <span class="text-white text-sm font-medium">Clean Energy Solutions</span>
                </div>
                <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-6 leading-tight">
                    Power Your Future with <span class="block bg-gradient-to-r from-emerald-400 to-green-200 bg-clip-text text-transparent">Solar Energy</span>
                </h1>
                <p class="text-lg md:text-2xl text-white/90 mb-8 max-w-2xl leading-relaxed">
                    Transform your energy costs with premium solar solutions. Professional installation, financing options, and 25-year warranty included.
                </p>
                <div class="grid grid-cols-3 gap-6 mb-8 max-w-md">
                    <div class="text-center bg-white/10 backdrop-blur rounded-lg p-3 border border-white/10"><div class="text-2xl font-bold text-white">500+</div><div class="text-white/80 text-xs sm:text-sm">Installations</div></div>
                    <div class="text-center bg-white/10 backdrop-blur rounded-lg p-3 border border-white/10"><div class="text-2xl font-bold text-white">25yr</div><div class="text-white/80 text-xs sm:text-sm">Warranty</div></div>
                    <div class="text-center bg-white/10 backdrop-blur rounded-lg p-3 border border-white/10"><div class="text-2xl font-bold text-white">90%</div><div class="text-white/80 text-xs sm:text-sm">Savings</div></div>
                </div>
                <div class="flex flex-col sm:flex-row gap-4 mb-8">
                    <a href="#calculator" class="bg-green-500 hover:bg-green-600 text-white px-6 py-3.5 rounded-lg text-lg font-semibold flex items-center justify-center group transition shadow-lg">
                        Calculate Solar Savings <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </a>
                    <a href="tel:9837067681" class="border border-white/40 text-white px-6 py-3.5 rounded-lg text-lg flex items-center justify-center hover:bg-white/10 backdrop-blur-sm transition">
                        <i class="fas fa-phone mr-2"></i> Call Now: 9837067681
                    </a>
                </div>
                <div class="flex flex-col sm:flex-row gap-6 text-white/80">
                    <div class="flex items-center space-x-2"><i class="fas fa-envelope text-green-400"></i><span class="text-sm">greenedgeinfratech@gmail.com</span></div>
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-1"><i class="fas fa-bolt text-yellow-400"></i><span class="text-sm">Clean Energy</span></div>
                        <div class="flex items-center space-x-1"><i class="fas fa-leaf text-green-400"></i><span class="text-sm">Eco Friendly</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-20 bg-gray-100">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <div class="inline-flex items-center space-x-2 bg-green-100 rounded-full px-4 py-2 mb-4">
                    <i class="fas fa-bolt text-green-600 w-4 h-4"></i><span class="text-green-600 text-sm font-medium">Our Services</span>
                </div>
                <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">Complete Solar Solutions</h2>
                <p class="text-xl text-gray-600 max-w-2xl mx-auto">From initial consultation to ongoing maintenance, we provide end-to-end solar energy services tailored to your specific needs and budget.</p>
            </div>

            <div id="services-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
                <% if (services && services.length > 0) { %>
                    <% services.slice(0, 6).forEach(service => { %>
                        <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition duration-300 flex flex-col justify-between">
                            <div>
                                <% if (service.image_path) { %>
                                    <img src="/<%= service.image_path %>" alt="<%= service.title %>" class="w-full h-48 object-cover rounded-lg mb-4">
                                <% } %>
                                <h3 class="text-xl font-bold mb-3 text-green-700">
                                    <%= service.title %>
                                </h3>
                                <p class="text-gray-600 mb-4 text-sm leading-relaxed">
                                    <%= service.description.replace(/<[^>]*>?/gm, '').substring(0, 160) %>...
                                </p>
                            </div>
                            <a href="/service-details?id=<%= service.id %>" class="inline-flex items-center text-green-600 font-semibold hover:text-green-700 text-sm mt-2">
                                Learn More <i class="fas fa-arrow-right ml-1.5 text-xs"></i>
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="col-span-3 text-center text-gray-500">No services available.</p>
                <% } %>
            </div>

            <div class="text-center">
                <a href="/services" class="inline-flex items-center bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition">
                    View All Services <i class="fas fa-arrow-right ml-2"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Why Solar Section -->
    <section id="why-solar" class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <div class="inline-flex items-center space-x-2 bg-green-100 rounded-full px-4 py-2 mb-6">
                        <i class="fas fa-leaf text-green-600 w-4 h-4"></i><span class="text-green-600 text-sm font-medium">Why Choose Solar</span>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">
                        Why We Need <span class="bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent block">Green Energy Solar</span>
                    </h2>
                    <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                        Green energy, such as solar power, is essential for a sustainable future. Solar energy is renewable, abundant, and emits zero greenhouse gases, making it a cleaner, high-yield alternative to fossil fuels.
                    </p>
                    <div class="space-y-4 mb-8">
                        <div class="flex items-center space-x-3"><div class="w-2.5 h-2.5 rounded-full bg-green-600"></div><span class="text-gray-800 font-medium">Renewable and abundant clean energy source</span></div>
                        <div class="flex items-center space-x-3"><div class="w-2.5 h-2.5 rounded-full bg-green-600"></div><span class="text-gray-800 font-medium">Zero greenhouse gas emissions & 80% lower carbon footprint</span></div>
                        <div class="flex items-center space-x-3"><div class="w-2.5 h-2.5 rounded-full bg-green-600"></div><span class="text-gray-800 font-medium">Huge government subsidies up to ₹1,08,000 under PM Surya Ghar</span></div>
                        <div class="flex items-center space-x-3"><div class="w-2.5 h-2.5 rounded-full bg-green-600"></div><span class="text-gray-800 font-medium">25-Year warranty with rapid payback in 3–5 years</span></div>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="p-6 text-center bg-gray-50 rounded-xl shadow hover:shadow-lg transition-all duration-300 border border-gray-100">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-green-600 to-emerald-500 flex items-center justify-center mx-auto mb-4"><i class="fas fa-leaf text-white text-xl"></i></div>
                        <div class="text-2xl font-bold text-green-600 mb-1">80% Less Carbon</div>
                        <h3 class="font-semibold mb-2">Environmental Impact</h3>
                        <p class="text-sm text-gray-600">Drastically reduce emissions with clean, rooftop generation.</p>
                    </div>
                    <div class="p-6 text-center bg-gray-50 rounded-xl shadow hover:shadow-lg transition-all duration-300 border border-gray-100">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-green-600 to-emerald-500 flex items-center justify-center mx-auto mb-4"><i class="fas fa-rupee-sign text-white text-xl"></i></div>
                        <div class="text-2xl font-bold text-green-600 mb-1">₹50k+ Annual Savings</div>
                        <h3 class="font-semibold mb-2">Cost Savings</h3>
                        <p class="text-sm text-gray-600">Save up to 90% on electricity bills with systems that pay for themselves.</p>
                    </div>
                    <div class="p-6 text-center bg-gray-50 rounded-xl shadow hover:shadow-lg transition-all duration-300 border border-gray-100">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-green-600 to-emerald-500 flex items-center justify-center mx-auto mb-4"><i class="fas fa-bolt text-white text-xl"></i></div>
                        <div class="text-2xl font-bold text-green-600 mb-1">90% Self Sufficient</div>
                        <h3 class="font-semibold mb-2">Energy Independence</h3>
                        <p class="text-sm text-gray-600">Generate your own clean electricity and hedge against grid tariff hikes.</p>
                    </div>
                    <div class="p-6 text-center bg-gray-50 rounded-xl shadow hover:shadow-lg transition-all duration-300 border border-gray-100">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-green-600 to-emerald-500 flex items-center justify-center mx-auto mb-4"><i class="fas fa-shield-alt text-white text-xl"></i></div>
                        <div class="text-2xl font-bold text-green-600 mb-1">25 Year Warranty</div>
                        <h3 class="font-semibold mb-2">Long-term Reliability</h3>
                        <p class="text-sm text-gray-600">Tier-1 panels and microinverters engineered for 25+ years performance.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Solar Calculator Section -->
    <section id="calculator" class="py-20 bg-gray-50 scroll-mt-20">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <div class="inline-flex items-center space-x-2 bg-green-100 rounded-full px-4 py-2 mb-4">
                    <i class="fas fa-calculator text-green-600 w-4 h-4"></i>
                    <span class="text-green-600 text-sm font-medium">Solar Calculator</span>
                </div>
                <h2 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">
                    Calculate Your Ideal 
                    <span class="bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent">
                        Solar System Size
                    </span>
                    In Minutes
                </h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                    Enter your electricity details and instantly get system size, savings, subsidy benefits, payback period, and environmental impact.
                </p>
            </div>

            <div class="max-w-4xl mx-auto bg-white border border-green-200 rounded-2xl p-6 sm:p-10 shadow-lg">
                <h3 class="text-lg font-semibold mb-3 text-gray-800">1. Select Calculation Basis</h3>
                <div class="grid sm:grid-cols-3 gap-4 mb-8">
                    <button type="button" class="calc-option active-option transition-all px-4 py-4 rounded-lg text-center font-semibold border border-green-600 bg-green-600 text-white shadow-md text-sm sm:text-base" data-type="bill">Monthly Electricity Bill</button>
                    <button type="button" class="calc-option transition-all px-4 py-4 rounded-lg text-center font-semibold border border-green-400 bg-white hover:bg-green-50 text-gray-700 text-sm sm:text-base" data-type="units">Monthly Consumption Units</button>
                    <button type="button" class="calc-option transition-all px-4 py-4 rounded-lg text-center font-semibold border border-green-400 bg-white hover:bg-green-50 text-gray-700 text-sm sm:text-base" data-type="area">Total Rooftop Area</button>
                </div>

                <div id="input-section" class="mb-6">
                    <div id="bill-input" class="toggle-input">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Monthly Electricity Bill (₹)</label>
                        <input id="input-bill" type="number" placeholder="e.g. 3500" value="3500" class="w-full border border-green-400 rounded-lg h-12 px-4 bg-white focus:outline-none focus:ring-2 focus:ring-green-500" />
                    </div>
                    <div id="units-input" class="toggle-input hidden">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Monthly Units (kWh)</label>
                        <input id="input-units" type="number" placeholder="e.g. 400" class="w-full border border-green-400 rounded-lg h-12 px-4 bg-white focus:outline-none focus:ring-2 focus:ring-green-500" />
                    </div>
                    <div id="area-input" class="toggle-input hidden">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Rooftop Area (sq ft)</label>
                        <input id="input-area" type="number" placeholder="e.g. 500" class="w-full border border-green-400 rounded-lg h-12 px-4 bg-white focus:outline-none focus:ring-2 focus:ring-green-500" />
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Select State</label>
                        <select id="state" class="w-full border border-green-400 rounded-lg h-12 px-3 bg-white focus:outline-none focus:ring-2 focus:ring-green-500">
                            <option value="Uttar Pradesh" selected>Uttar Pradesh</option>
                            <option value="Delhi">Delhi</option>
                            <option value="Rajasthan">Rajasthan</option>
                            <option value="Gujarat">Gujarat</option>
                            <option value="Maharashtra">Maharashtra</option>
                            <option value="Assam">Assam</option>
                            <option value="Tamil Nadu">Tamil Nadu</option>
                            <option value="West Bengal">West Bengal</option>
                            <option value="Odisha">Odisha</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Customer Category</label>
                        <select id="category" class="w-full border border-green-400 rounded-lg h-12 px-3 bg-white focus:outline-none focus:ring-2 focus:ring-green-500">
                            <option value="residential" selected>Residential</option>
                            <option value="commercial">Commercial</option>
                            <option value="industrial">Industrial</option>
                            <option value="institutional">Institutional</option>
                        </select>
                    </div>
                </div>

                <div class="mb-8">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Electricity Tariff / Unit Cost (₹ / kWh)</label>
                    <input id="unit-cost" type="number" value="7.5" step="0.1" placeholder="e.g. 7.5" class="w-full border border-green-400 rounded-lg h-12 px-4 bg-white focus:outline-none focus:ring-2 focus:ring-green-500" />
                </div>

                <button id="calculate-btn" type="button" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3.5 rounded-lg shadow-md text-lg transition duration-200">
                    <i class="fas fa-bolt mr-2"></i> Calculate Solar Estimate
                </button>
            </div>
        </div>
    </section>

    <!-- Solar Quote Lead Modal -->
    <div id="popup-form" class="fixed inset-0 bg-black/60 hidden flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl shadow-2xl p-6 sm:p-8 w-full max-w-md relative">
            <button id="close-popup" type="button" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-2xl font-bold">&times;</button>
            <h3 class="text-2xl font-bold mb-2 text-green-700">Get Your Solar Quote</h3>
            <p class="text-xs text-gray-500 mb-4">Enter your contact details to unlock your detailed report and subsidy calculation.</p>

            <form id="solar-form" class="space-y-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="John Doe" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
                </div>
                <div>
                    <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City / Town</label>
                    <input type="text" id="city" name="city" placeholder="Aligarh" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
                </div>
                <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Mobile Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="+91 98370 67681" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="john@example.com" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
                </div>

                <input type="hidden" name="system_size" id="form-system-size">
                <input type="hidden" name="estimated_cost" id="form-estimated-cost">
                <input type="hidden" name="monthly_generation" id="form-monthly-generation">
                <input type="hidden" name="payback_period" id="form-payback-period">
                <input type="hidden" name="annual_savings" id="form-annual-savings">
                <input type="hidden" name="category" id="form-category">
                <input type="hidden" name="area_required" id="form-area-required">
                <input type="hidden" name="state" id="form-state">
                <input type="hidden" name="unit_cost" id="form-unit-cost">
                <input type="hidden" name="calc_type" id="form-calc-type">
                <input type="hidden" name="calc_value" id="form-calc-value">

                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-bold shadow transition mt-2">
                    View Instant Estimate
                </button>
            </form>
        </div>
    </div>

    <!-- Solar Estimate Result Popup -->
    <div id="result-popup" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[92vh] overflow-y-auto relative border border-green-200 pdf-area p-6 sm:p-8">
            <button id="close-result" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl font-bold bg-gray-100 rounded-full w-8 h-8 flex items-center justify-center">&times;</button>

            <!-- Report Header -->
            <div class="border-b pb-4 mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center">
                <div class="flex items-center space-x-3">
                    <img src="/assets/logo.png" alt="Logo" class="w-12 h-auto">
                    <div>
                        <h3 class="text-xl font-bold text-green-700">Green Edge Infratech</h3>
                        <p class="text-xs text-gray-500">Rooftop Solar Feasibility & Savings Report</p>
                    </div>
                </div>
                <div class="mt-2 sm:mt-0 text-left sm:text-right text-xs text-gray-600">
                    <p>Customer: <strong id="cd-name">-</strong> (<span id="cd-city">-</span>)</p>
                    <p>Segment: <strong id="pdf-category-display">Residential</strong></p>
                </div>
            </div>

            <!-- Key Metrics Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
                <div class="bg-green-50 p-4 rounded-xl border border-green-200 text-center">
                    <div class="text-xs text-gray-600 font-medium">Recommended System</div>
                    <div id="popup-system-size" class="text-2xl font-bold text-green-700 mt-1">3.0 kW</div>
                </div>
                <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 text-center">
                    <div class="text-xs text-gray-600 font-medium">Monthly Generation</div>
                    <div id="popup-monthly-gen" class="text-2xl font-bold text-blue-700 mt-1">405 kWh</div>
                </div>
                <div class="bg-purple-50 p-4 rounded-xl border border-purple-200 text-center">
                    <div class="text-xs text-gray-600 font-medium">Annual Savings</div>
                    <div id="popup-annual-saving" class="text-2xl font-bold text-purple-700 mt-1">₹34,000</div>
                </div>
                <div class="bg-amber-50 p-4 rounded-xl border border-amber-200 text-center">
                    <div class="text-xs text-gray-600 font-medium">Payback Period</div>
                    <div id="popup-payback" class="text-2xl font-bold text-amber-700 mt-1">4.5 Years</div>
                </div>
            </div>

            <!-- Electricity Bill Comparison -->
            <div class="bg-slate-50 p-6 rounded-xl border border-gray-200 mb-6">
                <h4 class="font-bold text-gray-800 mb-4 text-center">Estimated Monthly Electricity Bill Comparison</h4>
                <div class="grid grid-cols-2 gap-6 text-center max-w-sm mx-auto">
                    <div>
                        <div class="text-xs text-gray-500 mb-2">Current Bill</div>
                        <div class="h-24 flex items-end justify-center">
                            <div id="oldBillBar" class="w-16 bg-red-400 rounded-t transition-all" style="height: 60px;"></div>
                        </div>
                        <div class="font-bold text-red-600 mt-2">₹<span id="ui-old-bill">3,500</span></div>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 mb-2">After Solar</div>
                        <div class="h-24 flex items-end justify-center">
                            <div id="newBillBar" class="w-16 bg-green-500 rounded-t transition-all" style="height: 15px;"></div>
                        </div>
                        <div class="font-bold text-green-700 mt-2">₹<span id="ui-new-bill">350</span></div>
                    </div>
                </div>
            </div>

            <!-- Financials and Environment -->
            <div class="grid md:grid-cols-2 gap-6 mb-6">
                <div class="bg-white p-4 rounded-xl border border-gray-200">
                    <h4 class="font-bold text-gray-800 mb-3">Financial Return Highlights</h4>
                    <div class="space-y-2 text-sm">
