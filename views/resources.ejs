<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resources - GreenEdge Infratech</title>
  <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">
  <%- include('partials/header') %>

  <section class="py-20 bg-green-900 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Resources & Downloads</h1>
      <p class="text-lg text-green-100 max-w-2xl mx-auto">
        Download brochures, technical specification sheets, and project portfolios.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="border rounded-2xl p-6 bg-gray-50 flex items-start space-x-4">
          <div class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center text-xl flex-shrink-0">
            <i class="fas fa-file-pdf"></i>
          </div>
          <div>
            <h3 class="font-bold text-lg text-gray-900 mb-1">Company Brochure 2026</h3>
            <p class="text-xs text-gray-500 mb-3">Overview of GreenEdge EPC capabilities, credentials, and installations.</p>
            <a href="/contact" class="text-green-600 font-semibold text-sm hover:underline">Request Copy →</a>
          </div>
        </div>

        <div class="border rounded-2xl p-6 bg-gray-50 flex items-start space-x-4">
          <div class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center text-xl flex-shrink-0">
            <i class="fas fa-solar-panel"></i>
          </div>
          <div>
            <h3 class="font-bold text-lg text-gray-900 mb-1">Rooftop Solar Guide</h3>
            <p class="text-xs text-gray-500 mb-3">Step-by-step documentation required for PM Surya Ghar subsidy in UP.</p>
            <a href="/calculator" class="text-green-600 font-semibold text-sm hover:underline">Calculate Now →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
