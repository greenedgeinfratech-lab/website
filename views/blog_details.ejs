<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= blog.title %> - GreenEdge Infratech</title>
  <meta name="description" content="<%= blog.content.replace(/<[^>]*>?/gm, '').substring(0, 155) %>">
  <link rel="canonical" href="https://greenedgeinfratech.com/blog_details?id=<%= blog.id %>" />
  <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">
  <%- include('partials/header') %>

  <main class="py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-sm text-gray-500 mb-8">
        <a href="/" class="hover:text-green-600">Home</a>
        <span>/</span>
        <a href="/blogs" class="hover:text-green-600">Blogs</a>
        <span>/</span>
        <span class="text-gray-900 truncate max-w-xs"><%= blog.title %></span>
      </nav>

      <article class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100 p-6 sm:p-10">
        <header class="mb-8">
          <div class="inline-flex items-center space-x-2 bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full mb-4">
            <i class="fas fa-solar-panel"></i>
            <span>Solar Energy & Subsidies</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
            <%= blog.title %>
          </h1>
          <div class="flex items-center space-x-4 text-sm text-gray-500 pb-6 border-b">
            <span><i class="fas fa-calendar-alt text-green-600 mr-1.5"></i> <%= blog.created_at ? blog.created_at.split(' ')[0] : 'Recent' %></span>
            <span><i class="fas fa-user text-green-600 mr-1.5"></i> GreenEdge Technical Desk</span>
          </div>
        </header>

        <% if (blog.image) { %>
          <div class="mb-10 rounded-xl overflow-hidden shadow-md">
            <img src="/uploads/<%= blog.image %>" alt="<%= blog.title %>" class="w-full max-h-[450px] object-cover">
          </div>
        <% } %>

        <div class="prose max-w-none text-gray-700 leading-relaxed space-y-4 text-base sm:text-lg whitespace-pre-line">
          <%= blog.content %>
        </div>

        <!-- Call to action card -->
        <div class="mt-12 bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-xl font-bold text-green-900 mb-1">Interested in Rooftop Solar?</h3>
            <p class="text-gray-600 text-sm">Calculate your exact subsidy eligibility and payback period in seconds.</p>
          </div>
          <a href="/calculator" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-lg shadow transition whitespace-nowrap">
            Try Solar Calculator
          </a>
        </div>
      </article>

      <!-- Back to blogs link -->
      <div class="mt-10 text-center">
        <a href="/blogs" class="inline-flex items-center text-green-600 font-semibold hover:text-green-700">
          <i class="fas fa-arrow-left mr-2"></i> Back to all articles
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
