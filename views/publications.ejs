<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Publications & Whitepapers - GreenEdge Infratech</title>
  <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">
  <%- include('partials/header') %>

  <section class="py-20 bg-green-900 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Research & Publications</h1>
      <p class="text-lg text-green-100 max-w-2xl mx-auto">
        Technical research whitepapers, grid integration case studies, and policy analysis.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl space-y-6">
      <div class="border rounded-2xl p-6 bg-gray-50">
        <span class="text-xs font-bold text-green-700 uppercase bg-green-100 px-2 py-0.5 rounded">Technical Paper</span>
        <h3 class="text-xl font-bold text-gray-900 mt-2 mb-1">Decentralized Rooftop Solar in Semi-Urban Western Uttar Pradesh</h3>
        <p class="text-sm text-gray-600 mb-3">Analysis of DISCOM distribution transformers loading, net-metering adoption, and voltage stability.</p>
        <a href="/contact" class="text-green-600 font-semibold text-sm hover:underline">Request Full Paper →</a>
      </div>

      <div class="border rounded-2xl p-6 bg-gray-50">
        <span class="text-xs font-bold text-green-700 uppercase bg-green-100 px-2 py-0.5 rounded">Case Study</span>
        <h3 class="text-xl font-bold text-gray-900 mt-2 mb-1">Solar PV Micro-Pumps for Sustainable Water Sourcing</h3>
        <p class="text-sm text-gray-600 mb-3">Field results comparing diesel genset irrigation vs. BLDC solar submersible pumping in smallholder farms.</p>
        <a href="/contact" class="text-green-600 font-semibold text-sm hover:underline">Request Full Paper →</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
