<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Our Products - GreenEdge Infratech</title>
  <meta name="description" content="Explore high-quality solar products, inverters, solar pumps, and photovoltaic modules from GreenEdge Infratech.">
  <link rel="canonical" href="https://greenedgeinfratech.com/products" />
  <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">
  <%- include('partials/header') %>

  <!-- Products Hero -->
  <section class="py-20 bg-slate-900 text-white relative">
    <div class="container mx-auto px-4 text-center">
      <div class="inline-flex items-center space-x-2 bg-white/20 backdrop-blur rounded-full px-4 py-1.5 mb-4 text-sm font-medium">
        <i class="fas fa-solar-panel text-green-400"></i>
        <span>Tier-1 Renewable Technology</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">High-Efficiency Solar Hardware</h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto">
        ALMM-approved solar panels, smart hybrid inverters, and agricultural solar pumps backed by comprehensive guarantees.
      </p>
    </div>
  </section>

  <!-- Products Catalog -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="bg-gray-50 rounded-2xl shadow-md p-6 hover:shadow-xl transition duration-300 border border-gray-100 flex flex-col justify-between">
              <div>
                <% if (product.image_path) { %>
                  <img src="/<%= product.image_path %>" alt="<%= product.name %>" class="w-full h-56 object-cover rounded-xl mb-4">
                <% } %>
                <h3 class="text-2xl font-bold mb-3 text-gray-900">
                  <%= product.name %>
                </h3>
                <p class="text-gray-600 mb-4 text-sm leading-relaxed">
                  <%= product.description %>
                </p>
              </div>
              <div class="pt-4 border-t border-gray-200">
                <a href="/products?slug=<%= product.slug %>" class="inline-flex items-center text-green-600 font-semibold hover:text-green-800 text-sm">
                  View Specifications <i class="fas fa-arrow-right ml-1.5 text-xs"></i>
                </a>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
