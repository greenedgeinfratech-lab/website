<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - GreenEdge Infratech</title>
  <meta name="description" content="Contact GreenEdge Infratech for customized solar rooftop installations, energy solutions, and consultations in Aligarh, Uttar Pradesh.">
  <link rel="canonical" href="https://greenedgeinfratech.com/contact" />
  <link rel="icon" href="/assets/image/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-gray-50 antialiased">
  <%- include('partials/header') %>

  <section class="py-20">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">Contact Us</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          We are here to answer your solar questions and help your residential or commercial projects switch to clean energy.
        </p>
      </div>

      <% if (success) { %>
        <div class="mb-8 p-4 bg-green-100 border border-green-300 text-green-800 rounded-xl text-center font-semibold">
          ✅ Thank you for contacting GreenEdge Infratech! We have received your inquiry and will call you back shortly.
        </div>
      <% } %>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div class="space-y-6">
          <div class="flex items-start space-x-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 flex items-center justify-center bg-green-600 text-white rounded-xl text-xl flex-shrink-0">
              <i class="fas fa-map-marker-alt"></i>
            </div>
            <div>
              <h4 class="font-bold text-lg text-gray-900 mb-1">Our Office</h4>
              <p class="text-gray-600 text-sm leading-relaxed">
                opp. BJP office Kayampur, Asadpur Kayam, Aligarh, Uttar Pradesh 202001
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 flex items-center justify-center bg-green-600 text-white rounded-xl text-xl flex-shrink-0">
              <i class="fas fa-phone"></i>
            </div>
            <div>
              <h4 class="font-bold text-lg text-gray-900 mb-1">Direct Phone</h4>
              <p class="text-gray-600 text-sm">+91 98370 67681</p>
              <p class="text-xs text-gray-500 mt-1">Mon - Sat: 9:00 AM - 6:00 PM</p>
            </div>
          </div>

          <div class="flex items-start space-x-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 flex items-center justify-center bg-green-600 text-white rounded-xl text-xl flex-shrink-0">
              <i class="fas fa-envelope"></i>
            </div>
            <div>
              <h4 class="font-bold text-lg text-gray-900 mb-1">Email Inquiries</h4>
              <p class="text-gray-600 text-sm">greenedgeinfratech@gmail.com</p>
              <p class="text-xs text-gray-500 mt-1">Response within 24 business hours</p>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <img src="/assets/image/Partner-with-Us.jpg" alt="Partner With Us" class="w-full h-48 object-cover">
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white p-8 rounded-2xl shadow-md border border-gray-100">
          <h3 class="text-2xl font-bold mb-6 text-gray-900">Send Us a Message</h3>
          <form action="/contact" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                <input id="first_name" name="first_name" type="text" placeholder="First Name" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
              </div>
              <div>
                <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                <input id="last_name" name="last_name" type="text" placeholder="Last Name" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
              <input id="email" name="email" type="email" placeholder="your@email.com" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
              <input id="phone" name="phone" type="tel" placeholder="+91 98370 67681" required class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
            </div>

            <div>
              <label for="property_type" class="block text-sm font-medium text-gray-700 mb-1">Property Type</label>
              <select id="property_type" name="property_type" class="w-full border rounded-lg h-11 px-3 focus:ring-2 focus:ring-green-500 outline-none">
                <option>Residential House</option>
                <option>Commercial Building</option>
                <option>Industrial Facility</option>
                <option>Agricultural Land</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="How can we assist you with solar power?" required class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-green-500 outline-none"></textarea>
            </div>

            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3.5 rounded-lg shadow transition">
              Submit Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
